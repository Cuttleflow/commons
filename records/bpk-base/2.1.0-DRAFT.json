  {
   "id": "bpk.end.e12",
   "heading": "E12 Specified Occupations",
   "trigger": {
    "questions": [
     "qs.bpk.situation.hazards"
    ],
    "rules": [
     {
      "when": "'deep_frying' in qs.bpk.situation.hazards or 'spray_painting' in qs.bpk.situation.hazards or 'woodworking' in qs.bpk.situation.hazards",
