  {
   "id": "bpk.end.e05",
   "heading": "E05 Increased Tenants' Liability",
   "trigger": {
    "questions": [
     "qs.bpk.liability.lease_tenants_liability_required"
    ],
    "rules": [
     {
      "when": "qs.bpk.liability.lease_tenants_liability_required > 2000000",
      "action": "refer"
     },
     {
      "when": "qs.bpk.liability.lease_tenants_liability_required > 500000",
      "action": "suggest"
     }
    ],
    "reason": "Considered because your lease requires tenants' liability cover of ${qs.bpk.liability.lease_tenants_liability_required}.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.bpk.liability.lease_tenants_liability_required",
     "text": "If the business leases premises, what tenants' liability limit does the lease require?",
     "type": "currency (AUD)",
     "used_by": "E05"
    }
   ]
  },
  {
   "id": "bpk.end.e06",
   "heading": "E06 Increased Property in Physical or Legal Control",
   "trigger": {
    "questions": [
     "qs.bpk.liability.property_in_care_value"
    ],
    "rules": [
     {
      "when": "qs.bpk.liability.property_in_care_value > 1000000",
      "action": "refer"
     },
     {
      "when": "qs.bpk.liability.property_in_care_value > 250000",
      "action": "suggest"
     }
    ],
    "reason": "Considered because you hold others' property worth up to ${qs.bpk.liability.property_in_care_value}.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.bpk.liability.property_in_care_value",
     "text": "What is the most value of other people's property in the business's care, custody or control at any one time?",
     "type": "currency (AUD)",
     "used_by": "E06"
    }
   ]
  },
  {
   "id": "bpk.end.e07",
   "heading": "E07 Product Recall Costs",
   "trigger": {
    "questions": [
     "qs.bpk.liability.products_supplied"
