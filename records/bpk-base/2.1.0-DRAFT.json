     "id": "qs.bpk.situation.hazards",
     "text": "Which of these take place at the Situation?",
     "type": "multi-select",
     "options": [
      "flammable_liquids",
      "spray_painting",
      "hot_works",
      "deep_frying",
      "woodworking",
      "none"
     ],
     "used_by": "R, A, E12"
    }
