 "endorsements": [
  {
   "id": "bpk.end.e01",
   "heading": "E01 Accidental Damage",
   "trigger": {
    "questions": [
     "qs.bpk.situation.accidental_damage_wanted"
    ],
    "rules": [
     {
      "when": "qs.bpk.situation.accidental_damage_wanted == yes",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because you asked for accidental damage cover at a Situation.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.bpk.situation.accidental_damage_wanted",
     "text": "Is accidental damage cover wanted at the Situation?",
     "type": "yes/no",
     "used_by": "E01"
    }
   ]
  },
  {
   "id": "bpk.end.e02",
   "heading": "E02 Flood",
   "trigger": {
    "questions": [
     "qs.bpk.situation.flood_history"
    ],
    "rules": [
     {
      "when": "qs.bpk.situation.flood_history == yes",
      "action": "refer"
     }
    ],
    "reason": "Considered because a Situation has flooded in the last 10 years or is in a flood-prone area.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with special excess",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.bpk.situation.flood_history",
     "text": "Has the Situation flooded in the last 10 years, or is it in an area shown as flood-prone?",
     "type": "yes/no",
     "used_by": "R, E02"
    }
   ]
  },
  {
   "id": "bpk.end.e03",
   "heading": "E03 Seasonal Stock Increase",
   "trigger": {
    "questions": [
     "qs.bpk.situation.seasonal_stock_increase_pct"
    ],
    "rules": [
     {
      "when": "qs.bpk.situation.seasonal_stock_increase_pct > 50",
      "action": "refer"
     },
     {
      "when": "qs.bpk.situation.seasonal_stock_increase_pct > 0",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because your stock rises by {qs.bpk.situation.seasonal_stock_increase_pct}% in peak months.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.bpk.situation.seasonal_stock_increase_pct",
     "text": "By what percentage does stock rise in peak months, if at all?",
     "type": "percentage, with the months",
     "used_by": "E03"
    }
   ]
  },
  {
   "id": "bpk.end.e04",
