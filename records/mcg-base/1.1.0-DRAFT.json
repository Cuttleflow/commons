 ],
 "endorsements": [
  {
   "id": "mcg.end.e01",
   "heading": "E01 Temperature-Controlled Goods",
   "trigger": {
    "questions": [
     "qs.mcg.goods.temperature_controlled"
    ],
    "rules": [
     {
      "when": "qs.mcg.goods.temperature_controlled == yes",
      "action": "refer"
     }
    ],
    "reason": "Referred because the goods include temperature-controlled goods; the underwriter sets the terms for refrigeration breakdown.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.mcg.goods.temperature_controlled",
     "text": "Do any of the goods need to be kept within a temperature range during transit?",
     "type": "yes/no",
     "used_by": "A, E01"
    }
   ]
  },
  {
   "id": "mcg.end.e02",
   "heading": "E02 Used Goods",
   "trigger": {
    "questions": [
     "qs.mcg.goods.second_hand"
    ],
    "rules": [
     {
      "when": "qs.mcg.goods.second_hand == yes",
      "action": "apply"
     }
    ],
    "reason": "Applies because some of the goods are used or second-hand."
   },
   "questions": [
    {
     "id": "qs.mcg.goods.second_hand",
     "text": "Are any of the goods used, second-hand or reconditioned?",
     "type": "yes/no",
     "used_by": "E02"
    }
   ]
  },
  {
   "id": "mcg.end.e03",
   "heading": "E03 Own Vehicle Carriage",
   "trigger": {
    "questions": [
     "qs.mcg.ops.own_vehicle_pct"
    ],
    "rules": [
     {
      "when": "qs.mcg.ops.own_vehicle_pct > 0",
      "action": "apply"
     }
    ],
    "reason": "Applies because {qs.mcg.ops.own_vehicle_pct}% of your inland sendings travel in your own vehicles."
   },
   "questions": [
    {
     "id": "qs.mcg.ops.own_vehicle_pct",
     "text": "What percentage of your inland sendings travels in your own vehicles?",
     "type": "percentage",
     "used_by": "R, E03"
    }
   ]
  },
  {
   "id": "mcg.end.e04",
   "heading": "E04 Dangerous Goods",
   "trigger": {
    "questions": [
     "qs.mcg.goods.dangerous_goods"
    ],
    "rules": [
     {
      "when": "qs.mcg.goods.dangerous_goods == yes",
      "action": "refer"
     }
    ],
    "reason": "Referred because the goods include dangerous goods; the underwriter confirms the classes and the terms.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.mcg.goods.dangerous_goods",
     "text": "Do any of the goods fall within a class of dangerous goods for transport?",
     "type": "yes/no",
     "used_by": "A, E04"
    }
   ]
  },
  {
   "id": "mcg.end.e05",
   "heading": "E05 Theft-Attractive Goods Excess",
   "trigger": {
    "questions": [
     "qs.mcg.goods.theft_attractive_pct"
    ],
