 "endorsements": [
  {
   "id": "pi.rl.end.on-hired-workers",
   "heading": "On-hired Workers",
   "trigger": {
    "questions": [
     "qs.pi.rl.onhire_pct",
     "qs.pi.rl.written_onhire_agreements"
    ],
    "rules": [
     {
      "when": "qs.pi.rl.onhire_pct > 0 and qs.pi.rl.written_onhire_agreements = yes",
      "action": "broker_option"
     },
     {
      "when": "qs.pi.rl.onhire_pct > 0 and qs.pi.rl.written_onhire_agreements = no",
      "action": "refer"
     }
    ],
    "reason": "Offered because you supply workers to hosts under written on-hire agreements."
   },
   "questions": [
    {
     "id": "qs.pi.rl.onhire_pct",
     "text": "What percentage of your fees in the last 12 months came from supplying workers on hire?",
     "type": "percentage",
     "used_by": "E (On-hired Workers)"
    },
    {
     "id": "qs.pi.rl.written_onhire_agreements",
     "text": "Do you supply all on-hired workers under a written agreement with the host that places day-to-day supervision with the host?",
     "type": "yes/no",
     "used_by": "E (On-hired Workers)"
    }
   ]
  },
  {
   "id": "pi.rl.end.payroll-administration",
   "heading": "Payroll Administration",
   "trigger": {
    "questions": [
     "qs.pi.rl.payroll_clients"
    ],
    "rules": [
     {
      "when": "qs.pi.rl.payroll_clients > 0",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because you run payroll for {qs.pi.rl.payroll_clients} clients.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.pi.rl.payroll_clients",
     "text": "For how many clients do you run payroll, including paying wages or superannuation on their behalf?",
     "type": "number",
     "used_by": "E (Payroll Administration)"
    }
   ]
  },
  {
   "id": "pi.rl.end.high-risk-placements",
   "heading": "High-Risk Placements Exclusion",
   "trigger": {
    "questions": [
     "qs.pi.rl.high_risk_pct"
    ],
    "rules": [
     {
      "when": "qs.pi.rl.high_risk_pct > 20",
      "action": "refer"
     }
    ],
    "reason": "Applies because {qs.pi.rl.high_risk_pct}% of your placements are in high-risk roles."
   },
   "questions": [
    {
     "id": "qs.pi.rl.high_risk_pct",
     "text": "What percentage of your placements in the last 12 months were in mining, construction, heavy industry, aviation, maritime, healthcare or security roles?",
     "type": "percentage",
     "used_by": "E (High-Risk Placements Exclusion)"
    }
   ]
  },
  {
   "id": "pi.rl.end.labour-hire-licences",
   "heading": "Labour Hire Licence Condition",
   "trigger": {
    "questions": [
     "qs.pi.rl.labour_hire_states",
     "qs.pi.rl.licence_numbers"
    ],
    "rules": [
     {
      "when": "qs.pi.rl.labour_hire_states is not empty",
      "action": "apply"
     }
    ],
    "reason": "Applies because you provide labour hire in a state or territory that requires a licence."
   },
   "questions": [
    {
     "id": "qs.pi.rl.labour_hire_states",
     "text": "In which states and territories do you supply labour hire workers?",
     "type": "multi-select (state or territory)",
     "used_by": "E (Labour Hire Licence Condition)"
    },
    {
     "id": "qs.pi.rl.licence_numbers",
     "text": "What are your labour hire licence numbers in each state or territory that requires one?",
     "type": "repeating (state, number)",
     "used_by": "E (Labour Hire Licence Condition)"
    }
   ]
  },
  {
   "id": "pi.rl.end.migration-advice",
   "heading": "Migration Advice",
   "trigger": {
    "questions": [
     "qs.pi.rl.migration_advice",
     "qs.pi.rl.marn"
    ],
    "rules": [
     {
      "when": "qs.pi.rl.migration_advice = yes",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because a registered migration agent advises your clients or candidates."
   },
   "questions": [
    {
     "id": "qs.pi.rl.migration_advice",
     "text": "Do you, or anyone acting for you, give migration advice or immigration assistance?",
     "type": "yes/no",
     "used_by": "E (Migration Advice)"
    },
    {
     "id": "qs.pi.rl.marn",
     "text": "If so, what is the name and registration number (MARN) of each registered migration agent who gives it?",
     "type": "repeating (name, MARN)",
     "used_by": "E (Migration Advice)"
    }
   ]
  },
  {
   "id": "pi.rl.end.automated-screening",
   "heading": "Automated Screening Exclusion",
   "trigger": {
    "questions": [
     "qs.pi.rl.ai_screening"
    ],
    "rules": [
     {
      "when": "qs.pi.rl.ai_screening = yes",
      "action": "suggest"
     }
    ],
    "reason": "Applies because you use automated tools to screen candidates."
   },
   "questions": [
    {
     "id": "qs.pi.rl.ai_screening",
     "text": "Do you use automated tools, including artificial intelligence, to screen or rank candidates?",
     "type": "yes/no, with details",
     "used_by": "E (Automated Screening Exclusion)"
    }
   ]
  }
 ],
 "sha256": "9862458ac9af999232d89dccac04cf533da286a28d1c55808c943c79424a1b76"
