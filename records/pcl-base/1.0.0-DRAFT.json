 "endorsements": [
  {
   "id": "pcl.end.e01",
   "heading": "E01 Worldwide Cover",
   "trigger": {
    "questions": [
     "qs.pcl.cover.worldwide_all_categories"
    ],
    "rules": [
     {
      "when": "qs.pcl.cover.worldwide_all_categories == yes",
      "action": "apply"
     }
    ],
    "reason": "Applies because worldwide cover for every category was chosen.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.pcl.cover.worldwide_all_categories",
     "text": "Do you want every category covered anywhere in the world, not only jewellery, watches and other valuables?",
