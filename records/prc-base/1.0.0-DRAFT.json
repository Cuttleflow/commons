 ],
 "endorsements": [
  {
   "id": "prc.end.e01",
   "heading": "E01 Third-party Recall Costs",
   "trigger": {
    "questions": [
     "qs.prc.products.role"
    ],
    "rules": [
     {
      "when": "qs.prc.products.role in ['contract_manufacturer', 'ingredient_supplier']",
      "action": "suggest"
     }
    ],
    "reason": "Suggested because you make products or ingredients for other brand owners, who may recover their recall costs from you."
   },
   "questions": [
    {
     "id": "qs.prc.products.role",
     "text": "What is the insured's role for these products?",
     "type": "select",
     "options": [
      "manufacturer",
      "contract_manufacturer",
      "ingredient_supplier",
      "brand_owner",
      "importer",
      "distributor",
      "retailer"
     ],
     "used_by": "R, E01"
    }
   ]
  },
  {
   "id": "prc.end.e02",
   "heading": "E02 Product Extortion",
   "trigger": {
    "questions": [
     "qs.prc.products.major_retail"
    ],
    "rules": [
     {
      "when": "qs.prc.products.major_retail == true",
      "action": "suggest"
     }
    ],
    "reason": "Suggested because your branded products are sold through major retailers, which makes them a target for extortion."
   },
   "questions": [
    {
     "id": "qs.prc.products.major_retail",
     "text": "Are the insured products sold under the insured's brand, or a retailer's own label, through major supermarket or retail chains?",
     "type": "yes/no",
     "used_by": "R, E02, E03"
    }
   ]
  },
  {
   "id": "prc.end.e03",
   "heading": "E03 Adverse Publicity",
   "trigger": {
    "questions": [
     "qs.prc.products.major_retail"
    ],
    "rules": [
     {
      "when": "qs.prc.products.major_retail == true",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because your branded products are sold through major retailers."
   },
   "questions": [
    {
     "id": "qs.prc.products.major_retail",
     "text": "Are the insured products sold under the insured's brand, or a retailer's own label, through major supermarket or retail chains?",
     "type": "yes/no",
     "used_by": "R, E02, E03"
    }
   ]
  },
  {
   "id": "prc.end.e04",
   "heading": "E04 USA and Canada",
   "trigger": {
    "questions": [
     "qs.prc.products.usa_canada_export"
    ],
    "rules": [
     {
      "when": "qs.prc.products.usa_canada_export == true",
      "action": "refer"
