 ],
 "endorsements": [
  {
   "id": "pa.lol.end.e05",
   "heading": "E05 Named Hazardous Pursuit",
   "trigger": {
    "questions": [
     "qs.pa.hazard.scuba_over_30m",
     "qs.pa.hazard.air_sports",
     "qs.pa.hazard.motor_racing",
     "qs.pa.hazard.mountaineering"
    ],
    "rules": [
     {
      "when": "qs.pa.hazard.scuba_over_30m == yes or qs.pa.hazard.air_sports == yes or qs.pa.hazard.motor_racing == yes or qs.pa.hazard.mountaineering == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because the insured person takes part in a pursuit the wording excludes.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.pa.hazard.scuba_over_30m",
     "text": "Does the insured person scuba dive below 30 metres?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.air_sports",
     "text": "Does the insured person take part in parachuting, skydiving, hang-gliding, paragliding, BASE jumping or ballooning?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.motor_racing",
     "text": "Does the insured person take part in races, rallies or speed trials in any motor vehicle or on a motorcycle?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.mountaineering",
     "text": "Does the insured person climb mountains above 4,000 metres, or take part in rodeo, bull riding or horse racing?",
     "type": "yes/no",
     "used_by": "A, E05"
    }
   ]
  },
  {
   "id": "pa.end.e06",
   "heading": "E06 Named Pursuit Exclusion",
   "trigger": {
    "questions": [
     "qs.pa.hazard.motorcycle_offroad",
     "qs.pa.hazard.climbing",
     "qs.pa.hazard.contact_sports",
     "qs.pa.hazard.equestrian"
    ],
    "rules": [
     {
      "when": "qs.pa.hazard.motorcycle_offroad == yes or qs.pa.hazard.climbing == yes or qs.pa.hazard.contact_sports == yes or qs.pa.hazard.equestrian == yes",
      "action": "suggest"
     }
    ],
    "reason": "Suggested as an alternative to a premium loading for a pursuit the insured person takes part in.",
    "responses": [
     "Attach",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.pa.hazard.motorcycle_offroad",
     "text": "Does the insured person ride a motorcycle off-road, other than in races or speed trials?",
     "type": "yes/no",
     "used_by": "R, E06"
    },
    {
     "id": "qs.pa.hazard.climbing",
     "text": "Does the insured person go rock climbing, abseiling or canyoning?",
     "type": "yes/no",
     "used_by": "R, E06"
    },
    {
     "id": "qs.pa.hazard.contact_sports",
     "text": "Does the insured person play amateur rugby, rugby league, Australian rules football, ice hockey, or compete in boxing or martial arts?",
     "type": "yes/no",
     "used_by": "R, E06"
    },
    {
     "id": "qs.pa.hazard.equestrian",
     "text": "Does the insured person ride horses, other than in races, rodeos or polo?",
     "type": "yes/no",
     "used_by": "R, E06"
    }
   ]
  },
  {
   "id": "pa.end.e07",
   "heading": "E07 Specific Condition Exclusion",
   "trigger": {
    "questions": [
     "qs.pa.medical.conditions_5yr",
     "qs.pa.medical.condition_details"
    ],
    "rules": [
     {
      "when": "qs.pa.medical.conditions_5yr == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because the insured person disclosed a medical condition in the last 5 years: {qs.pa.medical.condition_details}.",
    "responses": [
     "Attach",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.pa.medical.conditions_5yr",
     "text": "In the last 5 years, has the insured person had any injury, illness or condition that needed treatment, advice or time off work for more than 2 weeks, including any back, neck, joint, heart, mental health, cancer or diabetic condition?",
     "type": "yes/no",
     "used_by": "A, E07, E08"
    },
    {
     "id": "qs.pa.medical.condition_details",
     "text": "Give details of each condition, the treatment and the dates.",
     "type": "text",
     "used_by": "S, E07, E08"
    }
   ]
  },
  {
   "id": "pa.end.e08",
   "heading": "E08 Accepted Pre-existing Condition",
   "trigger": {
