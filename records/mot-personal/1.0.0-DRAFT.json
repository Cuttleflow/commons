 ],
 "endorsements": [
  {
   "id": "mot.end.e05",
   "heading": "E05 Agreed Value",
   "trigger": {
    "questions": [
     "qs.mot.vehicles.agreed_value_count"
    ],
    "rules": [
     {
      "when": "qs.mot.vehicles.agreed_value_count > 0",
      "action": "apply"
     }
    ],
    "reason": "Applies because {qs.mot.vehicles.agreed_value_count} vehicle(s) are insured for an agreed value.",
    "responses": [
     "Attach",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.mot.vehicles.agreed_value_count",
     "text": "How many vehicles are insured for an agreed value? (Derived.)",
     "type": "number",
     "used_by": "E05"
    }
   ]
  },
  {
   "id": "mot.end.e06",
   "heading": "E06 Increased Windscreen Cover",
   "trigger": {
    "questions": [
     "qs.mot.cover.windscreen_increased"
    ],
    "rules": [
     {
      "when": "qs.mot.cover.windscreen_increased == true",
      "action": "broker_option"
     }
    ],
    "reason": "Offered as an option to increase the windscreen benefit.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.mot.cover.windscreen_increased",
     "text": "Do you want the windscreen benefit increased?",
     "type": "yes/no",
     "used_by": "E06"
    }
   ]
  },
  {
   "id": "mot.end.e10",
   "heading": "E10 Extended Hire Vehicle",
   "trigger": {
    "questions": [
     "qs.mot.cover.hire_extended"
    ],
    "rules": [
     {
      "when": "qs.mot.cover.hire_extended == true",
      "action": "broker_option"
     }
    ],
    "reason": "Offered as an option to extend the hire vehicle benefit.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.mot.cover.hire_extended",
     "text": "Do you want the hire vehicle benefit extended?",
     "type": "yes/no",
     "used_by": "E10"
    }
   ]
  },
