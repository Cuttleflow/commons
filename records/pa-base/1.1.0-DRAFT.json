   "heading": "E05 Named Hazardous Pursuit",
   "trigger": {
    "questions": [
     "qs.pa.hazard.scuba_over_30m",
     "qs.pa.hazard.air_sports",
     "qs.pa.hazard.motor_racing",
     "qs.pa.hazard.private_pilot",
     "qs.pa.hazard.mountaineering"
    ],
    "rules": [
     {
      "when": "qs.pa.hazard.scuba_over_30m == yes or qs.pa.hazard.air_sports == yes or qs.pa.hazard.motor_racing == yes or qs.pa.hazard.private_pilot == yes or qs.pa.hazard.mountaineering == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because the insured person takes part in a pursuit the base wording excludes.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.pa.hazard.scuba_over_30m",
     "text": "Does the insured person scuba dive below 30 metres?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.air_sports",
     "text": "Does the insured person take part in parachuting, skydiving, hang-gliding, paragliding, BASE jumping or ballooning?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.motor_racing",
     "text": "Does the insured person take part in races, rallies or speed trials in any motor vehicle or on a motorcycle?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.private_pilot",
     "text": "Does the insured person fly an aircraft as a pilot or crew member, other than as their paid occupation?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.pa.hazard.mountaineering",
     "text": "Does the insured person climb mountains above 4,000 metres, or take part in rodeo, bull riding or horse racing?",
     "type": "yes/no",
     "used_by": "A, E05"
    }
   ]
  },
