     "qs.pa.cover.agreed_value"
    ],
    "rules": [
     {
      "when": "qs.pa.cover.agreed_value == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because an agreed weekly benefit was requested; it needs evidence of income before cover starts.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
