     "id": "qs.gtr.trips.max_duration",
     "text": "How long will the longest trip be?",
     "type": "select",
     "options": [
      "up_to_31",
      "32_to_90",
      "over_90"
     ],
     "used_by": "A, E06"
    }
   ]
  },
