 "endorsements": [
  {
   "id": "gtr.end.e01",
   "heading": "E01 Pre-existing Medical Conditions",
   "trigger": {
    "questions": [
     "qs.gtr.medical.preexisting_declared"
    ],
    "rules": [
     {
      "when": "qs.gtr.medical.preexisting_declared == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because the policyholder declared a traveller's pre-existing condition; acceptance needs medical underwriting.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.gtr.medical.preexisting_declared",
     "text": "Does any insured person want cover for a pre-existing medical condition?",
     "type": "yes/no",
     "used_by": "E01"
    }
   ]
  },
  {
   "id": "gtr.end.e02",
   "heading": "E02 Leisure Extension",
   "trigger": {
    "questions": [
     "qs.gtr.cover.leisure_days",
     "qs.gtr.cover.directors_leisure"
    ],
    "rules": [
     {
      "when": "qs.gtr.cover.directors_leisure == yes",
      "action": "broker_option"
     },
     {
      "when": "qs.gtr.cover.leisure_days > 7",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because the policyholder asked for more leisure travel than the base wording allows.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.gtr.cover.leisure_days",
     "text": "How many days of leisure travel before or after a business trip should be covered?",
     "type": "select",
     "options": [
      "7",
      "14",
      "21"
     ],
     "used_by": "R, S, E02"
    },
    {
     "id": "qs.gtr.cover.directors_leisure",
     "text": "Should directors and officers also be covered on leisure trips with no business purpose?",
     "type": "yes/no",
     "used_by": "R, S, E02"
    }
   ]
  },
  {
   "id": "gtr.end.e03",
   "heading": "E03 Hazardous Activities",
   "trigger": {
    "questions": [
     "qs.gtr.activities.hazardous"
    ],
    "rules": [
     {
      "when": "qs.gtr.activities.hazardous == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because insured persons will take part in an activity the base wording excludes.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.gtr.activities.hazardous",
     "text": "Will any insured person take part in an activity listed in the hazardous activities exclusion?",
     "type": "yes/no",
     "used_by": "E03"
    }
   ]
  },
  {
   "id": "gtr.end.e04",
   "heading": "E04 Epidemic and Pandemic Disruption",
   "trigger": {
    "questions": [
     "qs.gtr.cover.pandemic"
    ],
    "rules": [
     {
      "when": "qs.gtr.cover.pandemic == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because the policyholder asked for epidemic and pandemic disruption cover.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.gtr.cover.pandemic",
     "text": "Do you want cover for disruption caused by an insured person's own diagnosis or quarantine in an epidemic or pandemic?",
     "type": "yes/no",
     "used_by": "E04"
    }
   ]
  },
  {
   "id": "gtr.end.e05",
   "heading": "E05 Manual Work Overseas",
   "trigger": {
    "questions": [
     "qs.gtr.activities.manual_work"
    ],
    "rules": [
     {
      "when": "qs.gtr.activities.manual_work == yes",
      "action": "refer"
     }
    ],
    "reason": "Offered because insured persons will do manual work on a site the base wording excludes.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.gtr.activities.manual_work",
     "text": "Will any insured person do manual work on a construction, mining, oil and gas or engineering site, or work underground or offshore?",
     "type": "yes/no",
     "used_by": "E05"
    }
   ]
  },
  {
   "id": "gtr.end.e06",
   "heading": "E06 Long-Term Assignment",
   "trigger": {
    "questions": [
     "qs.gtr.trips.max_duration"
    ],
    "rules": [
     {
      "when": "qs.gtr.trips.max_duration == over_90",
      "action": "refer"
     }
    ],
    "reason": "Offered because a trip will be longer than the maximum trip duration.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
