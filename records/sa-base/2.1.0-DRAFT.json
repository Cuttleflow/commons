   "heading": "E04 Difference in Conditions",
   "trigger": {
    "questions": [
     "qs.sa.cover.options_requested"
    ],
    "rules": [
     {
      "when": "'E04' in qs.sa.cover.options_requested",
      "action": "broker_option"
     }
    ],
