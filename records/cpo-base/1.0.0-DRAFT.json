 "endorsements": [
  {
   "id": "cpo.end.e01",
   "heading": "E01 Flood Cover",
   "trigger": {
    "questions": [
     "qs.cpo.cover.flood_requested"
    ],
    "rules": [
     {
      "when": "qs.cpo.cover.flood_requested == yes",
      "action": "refer"
     }
    ],
    "reason": "Flood cover was requested; flood is priced by the underwriter for the address.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.cpo.cover.flood_requested",
     "text": "Do you want flood cover?",
     "type": "yes/no",
     "used_by": "E01"
    }
   ]
  },
  {
   "id": "cpo.end.e02",
   "heading": "E02 Known Defect",
   "trigger": {
    "questions": [
     "qs.cpo.condition.known_defects"
    ],
    "rules": [
     {
      "when": "qs.cpo.condition.known_defects == yes",
      "action": "refer"
     }
    ],
    "reason": "A known defect in the building was disclosed.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.cpo.condition.known_defects",
     "text": "Do you know of any defect in the building?",
     "type": "yes/no",
     "used_by": "A, E02"
    }
   ]
  },
  {
   "id": "cpo.end.e03",
   "heading": "E03 Building Works",
   "trigger": {
    "questions": [
     "qs.cpo.condition.building_works"
    ],
    "rules": [
     {
      "when": "qs.cpo.condition.building_works == yes",
      "action": "refer"
     }
    ],
    "reason": "Building works are planned or under way.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with special excess",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.cpo.condition.building_works",
     "text": "Are building works over $250,000, or needing approval, planned or under way?",
     "type": "yes/no",
     "used_by": "A, E03"
    }
   ]
  },
  {
   "id": "cpo.end.e04",
   "heading": "E04 Combustible Cladding",
   "trigger": {
    "questions": [
     "qs.cpo.building.combustible_cladding"
    ],
    "rules": [
     {
      "when": "qs.cpo.building.combustible_cladding == yes",
      "action": "refer"
     },
     {
      "when": "qs.cpo.building.combustible_cladding == unknown",
      "action": "refer"
     }
    ],
    "reason": "The building has, or may have, combustible external cladding.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.cpo.building.combustible_cladding",
     "text": "Does the building have aluminium composite panels, expanded polystyrene or other combustible external cladding?",
     "type": "select",
     "options": [
      "no",
      "yes",
      "unknown"
     ],
     "used_by": "A, E04"
    }
   ]
  },
  {
   "id": "cpo.end.e05",
   "heading": "E05 Higher-Hazard Tenancy",
   "trigger": {
    "questions": [
     "qs.cpo.tenancy.cooking_deep_frying",
     "qs.cpo.tenancy.spray_painting",
     "qs.cpo.tenancy.hot_work",
     "qs.cpo.tenancy.flammable_storage",
     "qs.cpo.tenancy.late_licensed"
    ],
    "rules": [
     {
      "when": "qs.cpo.tenancy.cooking_deep_frying == yes",
      "action": "refer"
     },
     {
      "when": "qs.cpo.tenancy.spray_painting == yes",
      "action": "refer"
     },
     {
      "when": "qs.cpo.tenancy.hot_work == yes",
      "action": "refer"
     },
     {
      "when": "qs.cpo.tenancy.flammable_storage == yes",
      "action": "refer"
     },
     {
      "when": "qs.cpo.tenancy.late_licensed == yes",
      "action": "refer"
     }
    ],
    "reason": "A tenancy is used for a higher-hazard activity.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.cpo.tenancy.cooking_deep_frying",
     "text": "Does any tenant cook commercially with deep fryers or open flame?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.cpo.tenancy.spray_painting",
     "text": "Does any tenant spray paint, or carry on panel beating or smash repairs?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.cpo.tenancy.hot_work",
     "text": "Does any tenant regularly do welding, cutting or other hot work?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.cpo.tenancy.flammable_storage",
     "text": "Does any tenant store flammable liquids or gases beyond small quantities for its own use?",
     "type": "yes/no",
     "used_by": "A, E05"
    },
    {
     "id": "qs.cpo.tenancy.late_licensed",
     "text": "Does any tenant trade with a liquor licence after midnight?",
     "type": "yes/no",
     "used_by": "A, E05"
    }
   ]
  },
  {
   "id": "cpo.end.e06",
   "heading": "E06 Vacant Tenancies",
   "trigger": {
    "questions": [
     "qs.cpo.occupancy.vacant_pct"
    ],
    "rules": [
     {
      "when": "qs.cpo.occupancy.vacant_pct > 50",
      "action": "refer"
     },
     {
      "when": "qs.cpo.occupancy.vacant_pct > 0",
      "action": "apply"
     }
    ],
    "reason": "{qs.cpo.occupancy.vacant_pct}% of the floor area is vacant.",
