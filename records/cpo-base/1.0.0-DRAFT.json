     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.cpo.occupancy.vacant_pct",
     "text": "What percentage of the building's floor area is vacant or unoccupied?",
     "type": "percentage",
     "used_by": "A, E06"
    }
   ]
  },
