 "endorsements": [
  {
   "id": "xol.end.e01",
   "heading": "E01 Difference in Conditions",
   "trigger": {
    "questions": [
     "qs.xol.endorsements.dic_requested"
    ],
    "rules": [
     {
      "when": "qs.xol.endorsements.dic_requested == true",
      "action": "refer"
     }
    ],
    "reason": "Referred because you asked for cover for differences between the followed policy and other underlying insurance.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.endorsements.dic_requested",
     "text": "Do you want this layer to cover differences between the followed policy and other underlying insurance?",
     "type": "yes/no",
     "used_by": "E01"
    }
   ]
  },
  {
   "id": "xol.end.e02",
   "heading": "E02 Reinstatement of the Limit of Liability",
   "trigger": {
    "questions": [
     "qs.xol.endorsements.reinstatement_requested"
    ],
    "rules": [
     {
      "when": "qs.xol.endorsements.reinstatement_requested == true",
      "action": "refer"
     }
    ],
    "reason": "Referred because you asked for the limit of liability to be reinstated.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.endorsements.reinstatement_requested",
     "text": "Do you want the limit of liability reinstated once after it is exhausted?",
     "type": "yes/no",
     "used_by": "E02"
    }
   ]
  },
  {
   "id": "xol.end.e03",
   "heading": "E03 Drop-down for Underlying Aggregate Exhaustion",
   "trigger": {
    "questions": [
     "qs.xol.endorsements.dropdown_aggregate_requested",
     "qs.xol.underlying.aggregate_eroded"
    ],
    "rules": [
     {
      "when": "qs.xol.endorsements.dropdown_aggregate_requested == true",
      "action": "refer"
     }
    ],
    "reason": "Referred because you asked for this layer to drop down when an aggregate underlying limit is reduced by paid loss.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.endorsements.dropdown_aggregate_requested",
     "text": "Do you want this layer to drop down when an aggregate underlying limit is reduced by paid loss?",
     "type": "yes/no",
     "used_by": "E03"
    },
    {
     "id": "qs.xol.underlying.aggregate_eroded",
     "text": "Has any aggregate underlying limit been reduced by paid or reserved loss in the current period? If yes, by how much?",
     "type": "yes/no, with amount",
     "used_by": "A, E03"
    }
   ]
  },
  {
   "id": "xol.end.e04",
   "heading": "E04 Defence Costs in Addition to the Limit",
   "trigger": {
    "questions": [
     "qs.xol.underlying.defence_costs_basis"
    ],
    "rules": [
     {
      "when": "qs.xol.underlying.defence_costs_basis == 'within'",
      "action": "broker_option"
     }
    ],
    "reason": "Offered because the followed policy pays defence costs within its limit.",
    "responses": [
     "Attach",
     "Attach with amended sub-limit",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.underlying.defence_costs_basis",
     "text": "Does the followed policy pay defence costs within its limit or in addition to it?",
     "type": "select",
     "options": [
      "within",
      "in_addition"
     ],
     "used_by": "S, E04"
    }
   ]
  },
  {
   "id": "xol.end.e05",
   "heading": "E05 Self-insured Retention",
   "trigger": {
    "questions": [
     "qs.xol.endorsements.sir_requested"
    ],
    "rules": [
     {
      "when": "qs.xol.endorsements.sir_requested == true",
      "action": "refer"
     }
    ],
    "reason": "Referred because you asked to retain part of the tower yourself in place of underlying insurance.",
    "responses": [
     "Attach",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.endorsements.sir_requested",
     "text": "Will the insured retain any layer of the tower itself in place of underlying insurance?",
     "type": "yes/no",
     "used_by": "E05"
    }
   ]
  },
  {
   "id": "xol.end.e06",
   "heading": "E06 Multi-year Underlying",
   "trigger": {
    "questions": [
     "qs.xol.underlying.multi_year"
    ],
    "rules": [
     {
      "when": "qs.xol.underlying.multi_year == true",
      "action": "suggest"
     }
    ],
    "reason": "Suggested because the followed policy has a period longer than twelve months.",
    "responses": [
     "Attach",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.underlying.multi_year",
     "text": "Is the followed policy written for a period longer than twelve months?",
     "type": "yes/no",
     "used_by": "E06"
    }
   ]
  },
  {
   "id": "xol.end.e07",
   "heading": "E07 USA and Canada",
   "trigger": {
    "questions": [
     "qs.xol.exposure.usa_canada"
    ],
    "rules": [
     {
      "when": "qs.xol.exposure.usa_canada == true",
      "action": "refer"
     }
    ],
    "reason": "Referred because you have exposure to claims brought in the USA or Canada.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.xol.exposure.usa_canada",
     "text": "Does the insured have assets, operations, revenue or clients in the USA or Canada?",
     "type": "yes/no",
     "used_by": "A, E07"
    }
   ]
  },
  {
   "id": "xol.end.e08",
   "heading": "E08 Specified Exclusion Changes",
   "trigger": {
    "questions": [
     "qs.xol.endorsements.exclusion_changes_requested"
    ],
    "rules": [
