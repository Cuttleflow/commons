 "endorsements": [
  {
   "id": "str.end.e01",
   "heading": "E01 Flood Cover",
   "trigger": {
    "questions": [
     "qs.str.cover.flood_requested"
    ],
    "rules": [
     {
      "when": "qs.str.cover.flood_requested == yes",
      "action": "refer"
     }
    ],
    "reason": "Referred because flood cover was requested; the underwriter prices it from the flood risk at the address.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.str.cover.flood_requested",
     "text": "Do you want flood cover?",
     "type": "yes/no",
     "used_by": "E01"
    }
   ]
  },
  {
   "id": "str.end.e02",
   "heading": "E02 Known Defect",
   "trigger": {
    "questions": [
     "qs.str.risk.known_defects",
     "qs.str.risk.defect_orders"
    ],
    "rules": [
     {
      "when": "qs.str.risk.defect_orders == yes",
      "action": "refer"
     },
     {
      "when": "qs.str.risk.known_defects == yes",
      "action": "refer"
     }
    ],
    "reason": "Referred because the body corporate has told us about a known defect or a defect order. Known defects are common; the underwriter decides the terms.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
    {
     "id": "qs.str.risk.known_defects",
     "text": "Does the body corporate know of any defect in the building, including waterproofing, structural, fire safety or cladding defects?",
     "type": "yes/no",
     "used_by": "A, E02"
    },
    {
     "id": "qs.str.risk.defect_orders",
     "text": "Has a council, building regulator or fire authority issued any order or notice about the building that has not been complied with?",
     "type": "yes/no",
     "used_by": "A, E02"
    }
   ]
  },
  {
   "id": "str.end.e03",
   "heading": "E03 Major Works",
   "trigger": {
    "questions": [
     "qs.str.risk.major_works"
    ],
    "rules": [
     {
      "when": "qs.str.risk.major_works == yes",
      "action": "refer"
     }
    ],
    "reason": "Referred because major works are under way or planned at the building.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach"
    ]
   },
   "questions": [
    {
     "id": "qs.str.risk.major_works",
     "text": "Are building works worth more than the lower of 20% of the building sum insured and $500,000 under way or planned in the next 12 months?",
     "type": "yes/no",
     "used_by": "A, E03"
    }
   ]
  },
  {
   "id": "str.end.e04",
   "heading": "E04 Combustible Cladding",
   "trigger": {
    "questions": [
     "qs.str.building.combustible_cladding"
    ],
    "rules": [
     {
      "when": "qs.str.building.combustible_cladding == yes",
      "action": "refer"
     },
     {
      "when": "qs.str.building.combustible_cladding == unknown",
      "action": "refer"
     }
    ],
    "reason": "Referred because the building has, or may have, combustible external cladding.",
    "responses": [
     "Attach",
     "Attach with special excess",
     "Attach with premium loading",
     "Do not attach",
     "Decline risk"
    ]
   },
   "questions": [
